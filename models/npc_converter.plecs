                Value         "[0 -1; -2 0; UpdateTs 0]"
                Show          off
              }
              Parameter {
                Variable      "TerminalBasedSampleTimes"
                Value         "1"
                Show          off
              }
              Parameter {
                Variable      "Parameters"
                Value         "DeadTime, UpdateTs"
                Show          off
              }
              Parameter {
                Variable      "LangStandard"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "GnuExtensions"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "RuntimeCheck"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "HighlightLevel"
                Value         "0"
                Show          off
              }
              Parameter {
                Variable      "Declarations"
                Value         "#include <float.h>\n"
"#include \"@ANPC_HEADER@\"\n"
"static AnpcGpioState lf_state;\n"
"static double lf_deadline, lf_last_tick;\n"
"static unsigned short lf_ready_held;\n"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "anpc_core_reset(&lf_state);\n"
"lf_deadline = DBL_MAX;\n"
"lf_last_tick = -DBL_MAX;\n"
"lf_ready_held = 0U;\n"
"NextSampleHit = DBL_MAX;\n"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "if (IsSampleHit(0)) {\n"
"    unsigned short positive = 0U;\n"
"    unsigned short enable = (InputSignal(1, 0) != 0.0);\n"
"    unsigned short changed;\n"
"    int i;\n"
"    for (i = 0; i < 3; ++i)\n"
"        if (InputSignal(0, i) != 0.0) positive |= (unsigned short)(1U << i);"
"\n"
"    changed = anpc_core_request(&lf_state, positive, enable);\n"
"    if (!enable) {\n"
"        lf_deadline = DBL_MAX;\n"
"        lf_ready_held = 0U;\n"
"        NextSampleHit = DBL_MAX;\n"
"    } else if (changed) {\n"
"        lf_deadline = CurrentTime + ParamRealData(0, 0);\n"
"        NextSampleHit = lf_deadline;\n"
"    }\n"
"}\n"
"if (IsSampleHit(1) && CurrentTime >= lf_deadline) {\n"
"    anpc_core_service(&lf_state);\n"
"    lf_deadline = DBL_MAX;\n"
"    NextSampleHit = DBL_MAX;\n"
"}\n"
"/* Match the DSP: release PWM only at a controller tick after initial\n"
" * low-frequency commutation is complete. Keep Ready during later changes. */"
"\n"
"if (IsSampleHit(2) && CurrentTime != lf_last_tick) {\n"
"    lf_ready_held = lf_state.ready;\n"
"    lf_last_tick = CurrentTime;\n"
"}\n"
"{\n"
"    int i;\n"
"    for (i = 0; i < 6; ++i)\n"
"        OutputSignal(0, i) = (lf_state.gates & (1U << i)) ? 1.0 : 0.0;\n"
"    OutputSignal(1, 0) = lf_state.enabled ? lf_ready_held : 0.0;\n"
"}\n"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "TerminateFcn"
                Value         ""
                Show          off
